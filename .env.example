# === Telegram (obrigatorio para publicar) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
TELEGRAM_ADMIN_CHAT_ID=
CHANNEL_INVITE_URL=

# === Lojas habilitadas (true/false) ===
ENABLE_MERCADOLIVRE=true
ENABLE_SHOPEE=false
ENABLE_AMAZON=false

# === Mercado Livre ===
# Token OAuth opcional (recomendado para evitar rate limit na busca)
ML_ACCESS_TOKEN=
# Parametro/tag de afiliado (opcional; anexado ao link quando configurado)
ML_AFFILIATE_PARAM=

# === Shopee Afiliados (Open Platform GraphQL) ===
SHOPEE_APP_ID=
SHOPEE_APP_SECRET=

# === Amazon Associados (PA-API 5.0 - liberar apos 3 vendas qualificadas) ===
AMAZON_ACCESS_KEY=
AMAZON_SECRET_KEY=
AMAZON_PARTNER_TAG=

# === Operacao ===
POLL_INTERVAL_MINUTES=20
MAX_POSTS_PER_CYCLE=2
MAX_POSTS_PER_DAY=15
COOLDOWN_DAYS=7
ACTIVE_START_HOUR=7
ACTIVE_START_MINUTE=30
ACTIVE_END_HOUR=22
ACTIVE_END_MINUTE=30
DB_PATH=data/bot.db
CONFIG_PATH=config/futevolei.json
